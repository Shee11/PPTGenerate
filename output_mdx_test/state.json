        "rank": 9,
        "state": "draft",
        "abstract": "AI career can be framed as phases: cloud vision, edge, cross-platform, Teams",
        "source_ref": {
          "source_id": "bf850924024cd35d",
          "file_path": "C:\\Users\\wangchao\\repos\\gggg\\data\\context\\simple_context.txt",
          "offset": 214,
          "length": 528,
          "line_number": null
        },
        "visual": "flow",
        "created_at": "2025-12-27T07:09:33.829149",
        "metadata": {},
        "text": "An AI career path can be structured into phases: starting with cloud-based vision algorithms and services, moving into edge inference on mobile, expanding to cross-platform inference and vision generation, and then integrating vision pipelines into large-scale products like Microsoft Teams.",
        "concept_type": "insight",
        "supporting_facts": [
          "fact_004",
          "fact_005",
          "fact_006",
          "fact_007"
        ]
      },
