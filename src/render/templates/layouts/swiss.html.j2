{% extends "base.html.j2" %}

{% block layout_styles %}
{% if slide_index %}
{% set scope = '#slide-' ~ slide_index ~ ' ' %}
{% else %}
{% set scope = '' %}
{% endif %}
{% if strategy == "Swiss.Poster" %}
{{ scope }}.swiss-layout {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
}
{{ scope }}.swiss-layout .widget {
    width: 100%;
    height: 100%;
}
{% elif strategy == "Swiss.Asymmetry" %}
{{ scope }}.swiss-layout {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
}
{{ scope }}.swiss-layout .widget {
    width: 60%;
    margin-left: 10%;
}
{% elif strategy == "Swiss.SplitTypo" %}
{{ scope }}.swiss-layout {
    display: flex;
    flex-direction: column;
    height: 100%;
}
{{ scope }}.swiss-layout .widget[data-role="headline"] {
    flex: 0 0 35%;
    display: flex;
    align-items: center;
    justify-content: center;
}
{{ scope }}.swiss-layout .widget[data-role="body"] {
    flex: 0 0 65%;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endif %}
{% endblock %}

{% block layout_content %}
<div class="swiss-layout">
    {% if strategy == "Swiss.Poster" %}
            {% set widget = widgets.get('headline') %}
            {% if widget %}
            <div class="widget" data-role="headline">
                {% include 'widgets/_widget_content.html.j2' %}
            </div>
            {% else %}
            <div class="widget">
                <div class="empty-slot">Empty headline slot</div>
            </div>
            {% endif %}
        {% elif strategy == "Swiss.Asymmetry" %}
            {% set widget = widgets.get('content') %}
            {% if widget %}
            <div class="widget" data-role="content">
                {% include 'widgets/_widget_content.html.j2' %}
            </div>
            {% else %}
            <div class="widget">
                <div class="empty-slot">Empty content slot</div>
            </div>
            {% endif %}
        {% elif strategy == "Swiss.SplitTypo" %}
            {% set headline_widget = widgets.get('headline') %}
            {% if headline_widget %}
            <div class="widget" data-role="headline">
                {% set widget = headline_widget %}
                {% include 'widgets/_widget_content.html.j2' %}
            </div>
            {% else %}
            <div class="widget" data-role="headline">
                <div class="empty-slot">Empty headline slot</div>
            </div>
            {% endif %}
            
            {% set body_widget = widgets.get('body') %}
            {% if body_widget %}
            <div class="widget" data-role="body">
                {% set widget = body_widget %}
                {% include 'widgets/_widget_content.html.j2' %}
            </div>
            {% else %}
            <div class="widget" data-role="body">
                <div class="empty-slot">Empty body slot</div>
            </div>
            {% endif %}
    {% endif %}
</div>
{% endblock %}
