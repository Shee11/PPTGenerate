{% extends "base.html.j2" %}

{% block layout_styles %}
.swiss-poster {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.swiss-poster .widget {
    width: 100%;
    height: 100%;
}
{% endblock %}

{% block layout_content %}
<div class="layout-content">
    <div class="swiss-poster">
        {% set widget = widgets.get('headline') %}
        {% if widget %}
        <div class="widget" data-role="headline">
            {% include 'widgets/_widget_content.html.j2' %}
        </div>
        {% else %}
        <div class="widget">
            <div class="empty-slot">Empty headline slot</div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
