{% extends "base.html.j2" %}

{% block layout_styles %}
.focus-layout {
    position: relative;
    width: 100%;
    height: 100%;
}

.focus-widget {
    position: absolute;
}
{% endblock %}

{% block layout_content %}
<div class="layout-content">
    <div class="focus-layout">
        {% for slot_name, widget_info in widgets.items() %}
        <div class="focus-widget widget" 
             data-role="{{ slot_name }}"
             style="left: {{ widget_info.bounds.x }}px; 
                    top: {{ widget_info.bounds.y }}px; 
                    width: {{ widget_info.bounds.width }}px; 
                    height: {{ widget_info.bounds.height }}px;">
            {% set widget = widget_info %}
            {% include 'widgets/_widget_content.html.j2' %}
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
