{% extends "base.html.j2" %}

{% block layout_styles %}
{% if strategy == "Bento.Standard" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
{% elif strategy == "Bento.HeroLeft" %}
.bento-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
.bento-cell[data-role="hero"] {
    grid-column: 1;
    grid-row: 1 / 3;
    z-index: 1;
}
.bento-cell[data-role="side_1"] { grid-column: 2; grid-row: 1; z-index: 2; }
.bento-cell[data-role="side_2"] { grid-column: 3; grid-row: 1; z-index: 2; }
.bento-cell[data-role="side_3"] { grid-column: 2; grid-row: 2; z-index: 2; }
.bento-cell[data-role="side_4"] { grid-column: 3; grid-row: 2; z-index: 2; }
{% elif strategy == "Bento.HeroTop" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 2fr 1fr;
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
.bento-cell[data-role="hero"] {
    grid-column: 1 / 4;
    grid-row: 1;
}
{% elif strategy == "Bento.Quarter" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
{% elif strategy == "Bento.VerticalStack" %}
.bento-stack-vertical {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    gap: 0;
}
.bento-stage-vertical {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    width: 100%;
}
.bento-stage-vertical .widget {
    width: auto;
    max-width: 80%;
}
.bento-arrow-vertical {
    font-size: 2rem;
    color: var(--color-text-secondary, #888);
    text-align: center;
    padding: 0.5rem 0;
    flex-shrink: 0;
}
{% endif %}

.bento-cell {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endblock %}

{% block layout_content %}
{% if strategy == "Bento.VerticalStack" %}
<div class="bento-stack-vertical">
{% else %}
<div class="bento-grid">
{% endif %}
    {% if strategy == "Bento.Standard" %}
            {% for i in range(1, 7) %}
                {% set widget = widgets.get('cell_' ~ i) %}
            <div class="bento-cell widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="cell_{{ i }}">
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% elif strategy == "Bento.HeroLeft" %}
                {% set widget = widgets.get('hero') %}
            <div class="bento-cell widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="hero">
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty hero slot</div>
                {% endif %}
            </div>
            <div class="bento-cell" data-role="side_1">
                {% for i in [1, 2] %}
                    {% set widget = widgets.get('side_' ~ i) %}
                <div class="widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="side_{{ i }}">
                    {% if widget %}
                        {% include 'widgets/_widget_content.html.j2' %}
                    {% else %}
                        <div class="empty-slot">Empty slot</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <div class="bento-cell" data-role="side_3">
                {% for i in [3, 4] %}
                    {% set widget = widgets.get('side_' ~ i) %}
                <div class="widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="side_{{ i }}">
                    {% if widget %}
                        {% include 'widgets/_widget_content.html.j2' %}
                    {% else %}
                        <div class="empty-slot">Empty slot</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% elif strategy == "Bento.HeroTop" %}
                {% set widget = widgets.get('hero') %}
            <div class="bento-cell widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="hero">
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty hero slot</div>
                {% endif %}
            </div>
            {% for i in range(1, 4) %}
                {% set widget = widgets.get('footer_' ~ i) %}
            <div class="bento-cell widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="footer_{{ i }}">
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% elif strategy == "Bento.Quarter" %}
            {% for i in range(1, 5) %}
                {% set widget = widgets.get('quadrant_' ~ i) %}
            <div class="bento-cell widget {% if widget and widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="quadrant_{{ i }}">
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% elif strategy == "Bento.VerticalStack" %}
            {# Vertical stack flow with optional connectors #}
            {% set connector = parameters.get('connector', 'none') %}
            {% for i in range(1, 5) %}
                {% set widget = widgets.get('stage_' ~ i) %}
                {% if widget %}
                <div class="bento-stage-vertical widget {% if widget.preset %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="stage_{{ i }}">
                    {% include 'widgets/_widget_content.html.j2' %}
                </div>
                {# Only show connector if enabled and there's a next stage #}
                {% if connector == 'arrow' and i < 4 and widgets.get('stage_' ~ (i + 1)) %}
                <div class="bento-arrow-vertical">↓</div>
                {% endif %}
                {% endif %}
            {% endfor %}
    {% endif %}
</div>
{% endblock %}
