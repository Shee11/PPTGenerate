{% extends "base.html.j2" %}

{% block layout_styles %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}

.bento-cell {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endblock %}

{% block layout_content %}
<div class="layout-content">
    <div class="bento-grid">
        {% for i in range(1, 7) %}
        <div class="bento-cell widget" data-role="cell_{{ i }}">
            {% set widget = widgets.get('cell_' ~ i) %}
            {% if widget %}
                {% include 'widgets/_widget_content.html.j2' %}
            {% else %}
                <div class="empty-slot">Empty slot</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
