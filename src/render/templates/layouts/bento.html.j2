{% extends "base.html.j2" %}

{% block layout_styles %}
{% if strategy == "Bento.Standard" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
{% elif strategy == "Bento.HeroLeft" %}
.bento-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
.bento-cell[data-role="hero"] {
    grid-column: 1;
    grid-row: 1 / 3;
}
.bento-cell[data-role="side_1"] { grid-column: 2; grid-row: 1; }
.bento-cell[data-role="side_2"] { grid-column: 2; grid-row: 1; }
.bento-cell[data-role="side_3"] { grid-column: 2; grid-row: 2; }
.bento-cell[data-role="side_4"] { grid-column: 2; grid-row: 2; }
.bento-grid .bento-cell[data-role^="side_"] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ gutter }};
}
.bento-grid .bento-cell[data-role="side_1"],
.bento-grid .bento-cell[data-role="side_3"] {
    grid-template-areas: "s1 s2";
}
{% elif strategy == "Bento.HeroTop" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 2fr 1fr;
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
.bento-cell[data-role="hero"] {
    grid-column: 1 / 4;
    grid-row: 1;
}
{% elif strategy == "Bento.Quarter" %}
.bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: {{ gutter }};
    width: 100%;
    height: 100%;
}
{% endif %}

.bento-cell {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endblock %}

{% block layout_content %}
<div class="layout-content">
    <div class="bento-grid">
        {% if strategy == "Bento.Standard" %}
            {% for i in range(1, 7) %}
            <div class="bento-cell widget" data-role="cell_{{ i }}">
                {% set widget = widgets.get('cell_' ~ i) %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% elif strategy == "Bento.HeroLeft" %}
            <div class="bento-cell widget" data-role="hero">
                {% set widget = widgets.get('hero') %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty hero slot</div>
                {% endif %}
            </div>
            <div class="bento-cell" data-role="side_1">
                {% for i in [1, 2] %}
                <div class="widget" data-role="side_{{ i }}">
                    {% set widget = widgets.get('side_' ~ i) %}
                    {% if widget %}
                        {% include 'widgets/_widget_content.html.j2' %}
                    {% else %}
                        <div class="empty-slot">Empty slot</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <div class="bento-cell" data-role="side_3">
                {% for i in [3, 4] %}
                <div class="widget" data-role="side_{{ i }}">
                    {% set widget = widgets.get('side_' ~ i) %}
                    {% if widget %}
                        {% include 'widgets/_widget_content.html.j2' %}
                    {% else %}
                        <div class="empty-slot">Empty slot</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% elif strategy == "Bento.HeroTop" %}
            <div class="bento-cell widget" data-role="hero">
                {% set widget = widgets.get('hero') %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty hero slot</div>
                {% endif %}
            </div>
            {% for i in range(1, 4) %}
            <div class="bento-cell widget" data-role="footer_{{ i }}">
                {% set widget = widgets.get('footer_' ~ i) %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% elif strategy == "Bento.Quarter" %}
            {% for i in range(1, 5) %}
            <div class="bento-cell widget" data-role="quadrant_{{ i }}">
                {% set widget = widgets.get('quadrant_' ~ i) %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty slot</div>
                {% endif %}
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}
