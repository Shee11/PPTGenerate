{# Data and metrics widgets rendering #}
{% if widget_type == 'Data.BigNum' %}
<div class="widget-data-bignum" style="{{ render_style(applied_style) }}">
    <div class="bignum-value" style="font-size: 3rem; font-weight: bold;">
        {% if widget_data.format == 'currency' %}
            ${{ widget_data.number }}
        {% elif widget_data.format == 'percentage' %}
            {{ widget_data.number }}%
        {% else %}
            {{ widget_data.number }}
        {% endif %}
    </div>
    {% if widget_data.show_label %}
    <div class="bignum-label" style="margin-top: 0.5rem; opacity: 0.7;">
        {{ widget_data.label }}
    </div>
    {% endif %}
</div>

{% elif widget_type == 'Data.Trend' %}
<div class="widget-data-trend" style="{{ render_style(applied_style) }}">
    {% set direction_color = {
        'up': '#10b981',
        'down': '#ef4444',
        'flat': '#6b7280'
    } %}
    <div class="trend-value" style="font-size: 2rem; font-weight: bold;">
        {{ widget_data.value }}
    </div>
    <div class="trend-change" style="color: {{ direction_color.get(widget_data.direction, '#6b7280') }};">
        {% if widget_data.direction == 'up' %}↑{% elif widget_data.direction == 'down' %}↓{% else %}→{% endif %} {{ widget_data.change }}
    </div>
    <div class="trend-label" style="margin-top: 0.5rem; opacity: 0.7;">
        {{ widget_data.label }}
    </div>
</div>

{% elif widget_type == 'Data.Progress' %}
<div class="widget-data-progress" style="{{ render_style(applied_style) }}">
    <div class="progress-label" style="margin-bottom: 0.5rem;">{{ widget_data.label }}</div>
    <div class="progress-bar" style="width: 100%; height: 20px; background: rgba(0,0,0,0.1); border-radius: 10px; overflow: hidden;">
        <div class="progress-fill" style="width: {{ widget_data.percentage }}%; height: 100%; background: currentColor;"></div>
    </div>
    {% if widget_data.show_percentage %}
    <div class="progress-percentage" style="margin-top: 0.25rem; font-size: 0.875rem; opacity: 0.7;">
        {{ widget_data.percentage|round(1) }}%
    </div>
    {% endif %}
</div>

{% else %}
<div class="widget-data-unknown">
    <p>Unknown data widget: {{ widget_type }}</p>
</div>
{% endif %}
