{# Typography widgets rendering #}
{% if widget_type == 'Type.Display' %}
<div class="widget-type-display" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; {{ render_style(applied_style) }}">
    <h1 class="display-text">
        {{ widget_data.content | markdown_format | safe }}
    </h1>
</div>

{% elif widget_type == 'Type.Heading' %}
<div class="widget-type-heading" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; {{ render_style(applied_style) }}">
    {% set level = widget_data.level %}
    {% if level == 1 %}
        <h1>{{ widget_data.content | markdown_format | safe }}</h1>
    {% elif level == 2 %}
        <h2>{{ widget_data.content | markdown_format | safe }}</h2>
    {% elif level == 3 %}
        <h3>{{ widget_data.content | markdown_format | safe }}</h3>
    {% elif level == 4 %}
        <h4>{{ widget_data.content | markdown_format | safe }}</h4>
    {% elif level == 5 %}
        <h5>{{ widget_data.content | markdown_format | safe }}</h5>
    {% else %}
        <h6>{{ widget_data.content | markdown_format | safe }}</h6>
    {% endif %}
</div>

{% elif widget_type == 'Type.Body' %}
<div class="widget-type-body" style="width: 100%; height: 100%; display: flex; align-items: center; {{ render_style(applied_style) }}">
    <p>{{ widget_data.content | markdown_format | safe }}</p>
</div>

{% elif widget_type == 'Type.List' %}
<div class="widget-type-list" style="{{ render_style(applied_style) }}">
    {% if widget_data.list_type == 'ordered' %}
        <ol>
        {% for item in widget_data['items'] %}
            <li>{{ item | markdown_format | safe }}</li>
        {% endfor %}
        </ol>
    {% else %}
        <ul>
        {% for item in widget_data['items'] %}
            <li>{{ item | markdown_format | safe }}</li>
        {% endfor %}
        </ul>
    {% endif %}
</div>

{% elif widget_type == 'Type.Quote' %}
<div class="widget-type-quote" style="width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; {{ render_style(applied_style) }} border-left: 4px solid var(--color-primary, #2563eb); padding-left: 1.5rem; border-radius: 8px;">
    <blockquote style="margin: 0;">
        <p style="margin-bottom: 0.5rem;">{{ widget_data.content | markdown_format | safe }}</p>
        {% if widget_data.citation %}
        <cite style="opacity: 0.7; font-style: italic;">{{ widget_data.citation | markdown_format | safe }}</cite>
        {% endif %}
    </blockquote>
</div>

{% else %}
<div class="widget-typography-unknown">
    <p>Unknown typography widget: {{ widget_type }}</p>
</div>
{% endif %}
