{% extends "base.html.j2" %}

{% block layout_styles %}
{% if strategy == "Cinematic.Split_50_50" %}
.cinematic-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ gutter }};
    height: 100%;
}
{% elif strategy == "Cinematic.Split_30_70" %}
.cinematic-layout {
    display: grid;
    grid-template-columns: 3fr 7fr;
    gap: {{ gutter }};
    height: 100%;
}
{% elif strategy == "Cinematic.FullBleed" %}
.cinematic-layout {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
}
.cinematic-layout .widget {
    width: 100%;
    height: 100%;
}
{% endif %}

.cinematic-panel {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}
{% endblock %}

{% block layout_content %}
<div class="cinematic-layout">
    {% if strategy == "Cinematic.Split_50_50" %}
            {% set left_widget = widgets.get('left') %}
            <div class="cinematic-panel widget" data-role="left">
                {% set widget = left_widget %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty left panel</div>
                {% endif %}
            </div>
            
            {% set right_widget = widgets.get('right') %}
            <div class="cinematic-panel widget" data-role="right">
                {% set widget = right_widget %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty right panel</div>
                {% endif %}
            </div>
        {% elif strategy == "Cinematic.Split_30_70" %}
            {% set sidebar_widget = widgets.get('sidebar') %}
            <div class="cinematic-panel widget" data-role="sidebar">
                {% set widget = sidebar_widget %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty sidebar</div>
                {% endif %}
            </div>
            
            {% set stage_widget = widgets.get('stage') %}
            <div class="cinematic-panel widget" data-role="stage">
                {% set widget = stage_widget %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty stage</div>
                {% endif %}
            </div>
        {% elif strategy == "Cinematic.FullBleed" %}
            {% set stage_widget = widgets.get('stage') %}
            <div class="widget {% if stage_widget and stage_widget.preset %}{% set widget = stage_widget %}{% include 'widgets/_preset_classes.html.j2' %}{% endif %}" data-role="stage">
                {% set widget = stage_widget %}
                {% if widget %}
                    {% include 'widgets/_widget_content.html.j2' %}
                {% else %}
                    <div class="empty-slot">Empty stage</div>
                {% endif %}
            </div>
    {% endif %}
</div>
{% endblock %}
