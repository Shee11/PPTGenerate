<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slidev Presentation</title>
    
    <!-- Import Slidev CSS and Vue runtime -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@slidev/client@latest/dist/index.css">
    <script type="module" src="https://cdn.jsdelivr.net/npm/@slidev/client@latest/dist/index.js"></script>
    
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        
        #slidev-container {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }
        
        /* Embedded markdown content (hidden, parsed by Slidev) */
        #slidev-markdown {
            display: none;
        }
    </style>
</head>
<body>
    <!-- Container for Slidev to mount -->
    <div id="slidev-container"></div>
    
    <!-- Embedded Slidev markdown content -->
    <script id="slidev-markdown" type="text/markdown">
{{ markdown_content }}
    </script>
    
    <!-- Initialize Slidev -->
    <script type="module">
        import { createApp } from 'https://cdn.jsdelivr.net/npm/vue@3/dist/vue.esm-browser.js'
        import Slidev from 'https://cdn.jsdelivr.net/npm/@slidev/client@latest/dist/index.js'
        
        // Get markdown content
        const markdownContent = document.getElementById('slidev-markdown').textContent
        
        // Create Slidev app
        const app = createApp(Slidev, {
            markdown: markdownContent,
            theme: 'default',
            highlighter: 'shiki',
            drawings: {
                enabled: true
            }
        })
        
        // Mount to container
        app.mount('#slidev-container')
    </script>
</body>
</html>
