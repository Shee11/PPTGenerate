        },
        "step2": {
          "type": "Type.Body",
          "parameters": {
            "text": "**Stay aware, not overwhelmed**\nSubscribe to a **few curated AI feeds** and skim for high-level trends."
          }
        },
        "step3": {
          "type": "Type.Body",
          "parameters": {
            "text": "**Learn by doing real work**\nAdopt a **task-driven** approach: try new AI tools when you have concrete tasks."
          }
        },
        "step4": {
          "type": "Type.Body",
          "parameters": {
            "text": "**Turn experiments into workflows**\nUse LLMs as **translators**: one good spec \u2192 slides, design docs, diagrams, even code structure."
          }
        }
      },
      "header": {
        "type": "Type.Subhead",
