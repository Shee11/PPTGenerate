            "cell_4": {
              "type": "Type.Code",
              "parameters": {
                "language": "python",
                "code": "# \ud83d\udeab Bad: unclear single-letter names\np = 100\nr = 0.08\nt = 5\na = p * (1 + r) ** t\n\n# \u2705 Good: descriptive names\nprincipal = 100\ninterest_rate = 0.08\nyears = 5\nfinal_amount = principal * (1 + interest_rate) ** years"
