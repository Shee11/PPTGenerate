{
  "id": "slate_professional",
  "name": "Slate Professional",
  "description": "Clean and neutral slate gray theme, versatile for any business or academic presentation",
  "margin_x": "55px",
  "margin_y": "45px",
  "gutter": "24px",
  "header_footer": {
    "header_height": "12%",
    "footer_height": "8%",
    "header_position": "fixed_top_left",
    "footer_position": "fixed_bottom_left",
    "header_decoration": "underline_subtle",
    "footer_decoration": "none"
  },
  "sequence_pattern": "alternating_background",
  "typography": {
    "h1": {
      "size": 54,
      "weight": "bold",
      "line_height": 1.15
    },
    "h2": {
      "size": 38,
      "weight": "semibold",
      "line_height": 1.2
    },
    "h3": {
      "size": 26,
      "weight": "medium",
      "line_height": 1.3
    },
    "body": {
      "size": 17,
      "weight": "regular",
      "line_height": 1.6
    },
    "caption": {
      "size": 13,
      "weight": "regular",
      "line_height": 1.5
    }
  },
  "primary_color": "#475569",
  "secondary_color": "#64748b",
  "accent_color": "#0ea5e9",
  "background_color": "#ffffff",
  "text_color": "#1e293b",
  "primary_background": "#f8fafc",
  "secondary_background": "#ffffff",
  "font_family": "IBM Plex Sans, sans-serif",
  "heading_font": "IBM Plex Sans, sans-serif"
}
