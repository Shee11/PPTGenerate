{
  "id": "ocean_deep",
  "name": "Ocean Deep",
  "description": "Calm and professional deep blue theme, great for corporate and financial presentations",
  "margin_x": "60px",
  "margin_y": "50px",
  "gutter": "28px",
  "header_footer": {
    "header_height": "12%",
    "footer_height": "8%",
    "header_position": "fixed_top_left",
    "footer_position": "fixed_bottom_left",
    "header_decoration": "underline_accent",
    "footer_decoration": "none"
  },
  "sequence_pattern": "section_break",
  "typography": {
    "h1": {
      "size": 56,
      "weight": "bold",
      "line_height": 1.15
    },
    "h2": {
      "size": 40,
      "weight": "semibold",
      "line_height": 1.2
    },
    "h3": {
      "size": 28,
      "weight": "medium",
      "line_height": 1.3
    },
    "body": {
      "size": 18,
      "weight": "regular",
      "line_height": 1.6
    },
    "caption": {
      "size": 14,
      "weight": "light",
      "line_height": 1.5
    }
  },
  "primary_color": "#0ea5e9",
  "secondary_color": "#06b6d4",
  "accent_color": "#22d3ee",
  "background_color": "#0c1929",
  "text_color": "#f0f9ff",
  "primary_background": "#0f2744",
  "secondary_background": "#0c1929",
  "font_family": "Source Sans Pro, sans-serif",
  "heading_font": "Montserrat, sans-serif"
}
