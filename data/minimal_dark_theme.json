{
  "id": "minimal_dark_v1",
  "margin_x": "60px",
  "margin_y": "40px",
  "gutter": "24px",
  "header_footer": {
    "header_height": "20%",
    "footer_height": "10%",
    "header_position": "centered",
    "footer_position": "centered",
    "header_decoration": "none",
    "footer_decoration": "none"
  },
  "sequence_pattern": "section_break",
  "typography": {
    "h1": {
      "size": 72,
      "weight": "black",
      "line_height": 1.0
    },
    "h2": {
      "size": 48,
      "weight": "bold",
      "line_height": 1.1
    },
    "h3": {
      "size": 32,
      "weight": "semibold",
      "line_height": 1.2
    },
    "body": {
      "size": 20,
      "weight": "light",
      "line_height": 1.6
    },
    "caption": {
      "size": 16,
      "weight": "light",
      "line_height": 1.5
    }
  },
  "primary_color": "#ffffff",
  "secondary_color": "#94a3b8",
  "accent_color": "#06b6d4",
  "background_color": "#0f172a",
  "text_color": "#f1f5f9",
  "primary_background": "#1e293b",
  "secondary_background": "#0f172a",
  "font_family": "Helvetica Neue, Arial, sans-serif",
  "heading_font": "Helvetica Neue, Arial, sans-serif"
}
