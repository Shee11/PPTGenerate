      "widgets": {
        "left": {
          "type": "Type.Display",
          "parameters": {
            "text": "What is Machine Learning?"
          }
        },
        "right": {
          "type": "Type.Body",
          "parameters": {
            "text": "Machine Learning is a subset of AI that enables systems to **learn and improve from experience** without being explicitly programmed.\n\n> \"A computer program is said to learn from experience E with respect to some class of tasks T and performance measure P, if its performance at tasks in T improves with experience E.\"\n>\n> — Tom Mitchell, 1997"
          }
        }
      },
      "header": {
        "type": "Type.Heading",
        "parameters": { "text": "" }
      },
