          "parameters": { "text": "The Bias-Variance Tradeoff" }
        },
        "left-title": {
          "type": "Type.Heading",
          "parameters": { "text": "Underfitting (High Bias)" }
        },
        "left-content": {
          "type": "Type.Body",
          "parameters": {
            "text": "Model is too simple\n\n❌ Poor training performance\n❌ Poor test performance\n\n**Solutions:**\n- Add more features\n- Increase model complexity\n- Train longer"
          }
        },
        "right-title": {
          "type": "Type.Heading",
          "parameters": { "text": "Overfitting (High Variance)" }
        },
        "right-content": {
          "type": "Type.Body",
          "parameters": {
            "text": "Model memorizes training data\n\n✅ Great training performance\n❌ Poor test performance\n\n**Solutions:**\n- Get more data\n- Regularization\n- Cross-validation"
          }
        }
      },
      "header": {
        "type": "Type.Heading",
        "parameters": { "text": "" }
