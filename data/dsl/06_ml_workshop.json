      "widgets": {
        "title": {
          "type": "Type.Heading",
          "parameters": { "text": "Common Algorithms" }
        },
        "card-1": {
          "type": "Type.Body",
          "parameters": { "text": "📈 **Linear Regression**\n\nPredict continuous values\nSimple, interpretable\nBaseline for many tasks" }
        },
        "card-2": {
          "type": "Type.Body",
          "parameters": { "text": "🌳 **Decision Trees**\n\nTree-like decision rules\nEasy to visualize\nProne to overfitting" }
        },
        "card-3": {
          "type": "Type.Body",
          "parameters": { "text": "🎯 **Random Forest**\n\nEnsemble of trees\nRobust performance\nHandles missing data" }
        },
        "card-4": {
          "type": "Type.Body",
          "parameters": { "text": "🧠 **Neural Networks**\n\nDeep learning foundation\nComplex patterns\nRequires lots of data" }
        },
        "card-5": {
          "type": "Type.Body",
          "parameters": { "text": "📊 **SVM**\n\nMaximum margin classifier\nEffective in high dimensions\nKernel tricks available" }
        },
        "card-6": {
          "type": "Type.Body",
          "parameters": { "text": "🔮 **K-Nearest Neighbors**\n\nInstance-based learning\nNo training phase\nSensitive to distance metric" }
        }
      },
      "header": {
        "type": "Type.Heading",
        "parameters": { "text": "" }
      },
      "footer": {
        "type": "Type.Body",
