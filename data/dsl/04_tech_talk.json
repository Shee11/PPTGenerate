    {
      "id": "slide_05_patterns",
      "rank": 5,
      "layout": "cards-grid",
      "theme": "dark",
      "parameters": {
        "vibe": "professional",
        "columns": 3,
        "cardStyle": "outlined"
      },
      "widgets": {
        "title": {
          "type": "Type.Heading",
          "parameters": { "text": "Key Patterns" }
        },
        "card-1": {
          "type": "Type.Body",
          "parameters": { "text": "🚪 API Gateway\n\nSingle entry point for all clients, handles auth, rate limiting, routing" }
        },
        "card-2": {
          "type": "Type.Body",
          "parameters": { "text": "💔 Circuit Breaker\n\nPrevent cascade failures, fail fast, provide fallbacks" }
        },
        "card-3": {
          "type": "Type.Body",
          "parameters": { "text": "📨 Event Sourcing\n\nStore events, derive state, enable replay and audit" }
        },
        "card-4": {
          "type": "Type.Body",
          "parameters": { "text": "🔄 CQRS\n\nSeparate read/write models for optimization" }
        },
        "card-5": {
          "type": "Type.Body",
          "parameters": { "text": "📦 Saga Pattern\n\nDistributed transactions via choreography or orchestration" }
        },
        "card-6": {
          "type": "Type.Body",
          "parameters": { "text": "🎭 Sidecar\n\nOffload cross-cutting concerns to companion containers" }
        }
      },
      "header": {
        "type": "Type.Heading",
        "parameters": { "text": "" }
      },
      "footer": {
        "type": "Type.Body",
        "parameters": { "text": "TechConf 2025" }
      }
