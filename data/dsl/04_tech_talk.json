      "widgets": {
        "title": {
          "type": "Type.Heading",
          "parameters": { "text": "Mistakes We Made" }
        },
        "step1": {
          "type": "Type.Body",
          "parameters": {
            "title": "Too Many Services",
            "text": "Started with 200 services for 20 engineers → 10:1 ratio is too high"
          }
        },
        "step2": {
          "type": "Type.Body",
          "parameters": {
            "title": "Shared Libraries",
            "text": "Common lib became a monolith → Extract interfaces, version carefully"
          }
        },
        "step3": {
          "type": "Type.Body",
          "parameters": {
            "title": "No Service Ownership",
            "text": "Nobody owned services → Implement team topology mapping"
          }
        },
        "step4": {
          "type": "Type.Body",
          "parameters": {
            "title": "Network as Afterthought",
            "text": "Ignored network failures → Design for failure from day one"
          }
        }
      },
