      "widgets": {
        "cell1": {
          "type": "Type.Body",
          "parameters": { "text": "📊 Metrics\n\nPrometheus + Grafana\n\n- Golden signals (latency, traffic, errors, saturation)\n- Business metrics\n- SLO dashboards" }
        },
        "cell2": {
          "type": "Type.Body",
          "parameters": { "text": "📝 Logging\n\nELK Stack\n\n- Structured JSON logs\n- Correlation IDs\n- Log aggregation\n- Alert on patterns" }
        },
        "cell3": {
          "type": "Type.Body",
          "parameters": { "text": "🔍 Tracing\n\nJaeger + OpenTelemetry\n\n- Distributed traces\n- Span context propagation\n- Service dependency maps" }
        }
      },
      "header": {
        "type": "Type.Heading",
        "parameters": { "text": "The Three Pillars of Observability" }
      },
